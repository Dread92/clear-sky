__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- tools / editors ----
.idea/
.DS_Store
Thumbs.db

# ---- misc ----
cloudflared.exe
*.log

# scratch: files moved aside for you to delete
_to_delete/
