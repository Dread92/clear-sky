{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Clear Sky - run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/server.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Clear Sky - demo (no API keys needed)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/server.py",
      "args": ["--demo"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Clear Sky - demo on port 8099",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/server.py",
      "args": ["--demo", "--port", "8099"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
